{
  "mcpServers": {
    "phoenix": {
      "command": "npx",
      "args": ["-y", "@arizeai/phoenix-mcp"],
      "env": {
        "PHOENIX_API_KEY": "${PHOENIX_API_KEY}",
        "PHOENIX_COLLECTOR_ENDPOINT": "${PHOENIX_COLLECTOR_ENDPOINT}",
        "PHOENIX_PROJECT_NAME": "decision-council-demo"
      }
    }
  }
}
